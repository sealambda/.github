# Text style of every Sealambda repository. Editors and Prettier read it. shfmt does not.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# make requires a tab at the start of a recipe line.
[Makefile]
indent_style = tab
